{
  "openapi": "3.0.3",
  "info": { "title": "Things API", "version": "1.0.0" },
  "paths": {
    "/api/things": {
      "post": {
        "operationId": "createThing",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "nickname"],
                "properties": {
                  "email": { "type": "string" },
                  "nickname": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id"],
                  "properties": { "id": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "/api/things/{id}": {
      "get": {
        "operationId": "getThing",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name", "createdAt"],
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "createdAt": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["message"],
                  "properties": { "message": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
