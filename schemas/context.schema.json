{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "collector": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "source",
                  "test",
                  "config",
                  "doc"
                ]
              },
              "lines": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "hash": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "kind",
              "lines",
              "hash"
            ],
            "additionalProperties": false
          }
        },
        "gitStatus": {
          "type": "object",
          "properties": {
            "branch": {
              "type": "string"
            },
            "lastCommit": {
              "type": "string"
            },
            "dirty": {
              "type": "boolean"
            }
          },
          "required": [
            "branch",
            "lastCommit",
            "dirty"
          ],
          "additionalProperties": false
        },
        "memoryEntries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "relevanceScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "excerptHash": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "title",
              "relevanceScore",
              "excerptHash"
            ],
            "additionalProperties": false
          }
        },
        "deps": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": [
                  "package.json",
                  "pnpm-lock.yaml",
                  "yarn.lock"
                ]
              },
              "resolved": {
                "type": "string"
              }
            },
            "required": [
              "version",
              "source",
              "resolved"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "files",
        "gitStatus",
        "memoryEntries",
        "deps"
      ],
      "additionalProperties": false
    },
    "docRetriever": {
      "type": "object",
      "properties": {
        "fetchedDocs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dep": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": [
                  "local-cache",
                  "remote-fetch"
                ]
              },
              "url": {
                "type": "string"
              },
              "fetchedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "contentHash": {
                "type": "string"
              },
              "sections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "tokenEstimate": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "excerpt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "title",
                    "tokenEstimate",
                    "excerpt"
                  ],
                  "additionalProperties": false
                }
              },
              "stale": {
                "type": "boolean"
              }
            },
            "required": [
              "dep",
              "version",
              "source",
              "fetchedAt",
              "contentHash",
              "sections",
              "stale"
            ],
            "additionalProperties": false
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dep": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "unconfigured",
                  "network_error",
                  "version_unknown"
                ]
              }
            },
            "required": [
              "dep",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "fetchedDocs",
        "skipped"
      ],
      "additionalProperties": false
    },
    "tokenizer": {
      "type": "object",
      "properties": {
        "metadata": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "doc",
                  "code",
                  "memory",
                  "git"
                ]
              },
              "version": {
                "type": "string"
              },
              "blastRadius": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "conflictScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "timeDecayScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "kind",
              "blastRadius",
              "conflictScore",
              "timeDecayScore",
              "tags"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "metadata"
      ],
      "additionalProperties": false
    },
    "renderer": {
      "type": "object",
      "properties": {
        "audience": {
          "type": "string",
          "enum": [
            "peaks-rd",
            "peaks-qa",
            "peaks-mut",
            "all"
          ]
        },
        "renderedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "truncated": {
          "type": "boolean"
        },
        "truncatedReason": {
          "type": "string",
          "enum": [
            "doc_budget_exceeded",
            "section_count_exceeded"
          ]
        }
      },
      "required": [
        "audience",
        "renderedAt",
        "sizeBytes",
        "truncated"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "goal",
    "generatedAt",
    "sha256",
    "collector",
    "docRetriever",
    "tokenizer",
    "renderer"
  ],
  "additionalProperties": false
}